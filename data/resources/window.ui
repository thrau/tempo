<?xml version="1.0" encoding="UTF-8"?>
<!--
  Main application window defined in GtkBuilder XML.
  This is the Clocks-style shell: a header bar plus a content area.
  The individual tabs (Alarm, Timer, Stopwatch) will be added here later.
-->
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="TempoWindow" parent="AdwApplicationWindow">
    <property name="default-width">400</property>
    <property name="default-height">600</property>
    <property name="title">Tempo</property>
    <child>
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
              <object class="AdwWindowTitle">
                <property name="title" translatable="yes">Tempo</property>
              </object>
            </property>
          </object>
        </child>
        <property name="content">
          <!-- Placeholder content; tab views for Alarm/Timer/Stopwatch go here -->
          <object class="AdwStatusPage">
            <property name="icon-name">preferences-system-time-symbolic</property>
            <property name="title" translatable="yes">Tempo</property>
            <property name="description" translatable="yes">Timer, alarm and stopwatch</property>
          </object>
        </property>
      </object>
    </child>
  </template>
</interface>
