<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.5"/>
  <template class="TempoWindow" parent="AdwApplicationWindow">
    <property name="default-width">640</property>
    <property name="default-height">660</property>
    <property name="title">Tempo</property>
    <style><class name="tempo"/></style>
    <property name="content">
      <object class="AdwToastOverlay" id="overlay">
        <property name="child">
          <object class="AdwToolbarView">
            <child type="top">
              <object class="AdwHeaderBar">
                <property name="title-widget">
                  <object class="GtkStackSwitcher">
                    <property name="stack">pages</property>
                  </object>
                </property>
              </object>
            </child>
            <property name="content">
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkStack" id="pages">
                    <property name="vexpand">true</property>
                    <property name="transition-type">crossfade</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label">Keep Tempo open to receive alerts · Times use your local timezone</property>
                    <property name="wrap">true</property>
                    <property name="margin-start">16</property>
                    <property name="margin-end">16</property>
                    <property name="margin-bottom">12</property>
                    <style><class name="dim-label"/><class name="caption"/></style>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
